{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCloudTrailPutObject",
      "Effect": "Allow",
      "Principal": {"Service": "cloudtrail.amazonaws.com"},
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::media-gallery-abcxyz-olu-logs/cloudtrail/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceAccount": "464975959576"
        },
        "StringLike": {
          "aws:SourceArn": "arn:aws:cloudtrail:eu-west-2:464975959576:trail/*"
        }
      }
    },
    {
      "Sid": "AllowCloudTrailGetBucketAcl",
      "Effect": "Allow",
      "Principal": {"Service": "cloudtrail.amazonaws.com"},
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::media-gallery-abcxyz-olu-logs",
      "Condition": {
        "StringEquals": {"aws:SourceAccount": "464975959576"}
      }
    },
    {
      "Sid": "AllowCloudFrontStandardLoggingV2ToWrite",
      "Effect": "Allow",
      "Principal": {"Service": "delivery.logs.amazonaws.com"},
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::media-gallery-abcxyz-olu-logs/cloudfront-logs/*",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "464975959576"
        }
      }
    }
  ]
}